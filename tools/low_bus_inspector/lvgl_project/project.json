{
  "name": "low_bus_inspector",
  "version": "1.0.0",
  "editor_version": "1.0.0",
  "display": {
    "width": 800,
    "height": 480,
    "color_depth": 16,
    "rotation": 0,
    "fps": 60,
    "default_font": "montserrat_14"
  },
  "target": {
    "board": "Waveshare ESP32-S3-Touch-LCD-4.3B-BOX",
    "sku": "28141",
    "mcu": "ESP32-S3-WROOM-1-N16R8",
    "flash_size_mb": 16,
    "psram_size_mb": 8,
    "display_controller": "ST7262_RGB",
    "touch_controller": "GT911"
  },
  "styles": [
    "styles/styles.xml"
  ],
  "views": [
    "views/view_general_bus.xml",
    "views/view_steer_digits.xml",
    "views/view_steer_plot.xml",
    "views/view_brake_digits.xml",
    "views/view_brake_plot.xml",
    "views/view_drive_digits.xml",
    "views/view_drive_plot.xml"
  ],
  "initial_view": "view_general_bus",
  "export": {
    "c_output_dir": "../firmware/main/ui",
    "prefix": "inspector_ui"
  }
}
