<?xml version="1.0"?>
<!--
  Copyright 2026 E-Trike Dev. All rights reserved.
  E-Trike BEVFusion Bringup Launch File.
  Seamlessly brings up:
    1. Hesai PointXYZIRC Adapter (converting raw/synthetic point clouds to 16-byte PointXYZIRC layout)
    2. Autoware BEVFusion multi-modal inference node (Camera + LiDAR)
-->
<launch>
  <arg name="model_name" default="bevfusion_lidar" description="bevfusion_lidar or bevfusion_camera_lidar"/>
  <arg name="data_path" default="/workspace/data/ml_models"/>
  <arg name="model_path" default="$(var data_path)/bevfusion"/>
  <arg name="build_only" default="false" description="Set true to synthesize TensorRT engine then exit"/>
  <arg name="log_level" default="info"/>

  <arg name="input/raw_pointcloud" default="/sensing/lidar/top/pointcloud_raw_ex"/>
  <arg name="input/pointcloud" default="/sensing/lidar/concatenated/pointcloud"/>
  <arg name="output/objects" default="/perception/object_recognition/detection/objects"/>

  <arg name="camera_image" default="/kinect_front/color/image_raw"/>
  <arg name="camera_info" default="/kinect_front/depth/camera_info"/>

  <!-- 1. PointXYZIRC Adapter Node -->
  <node pkg="etrike_common_launch" exec="hesai_pointxyzirc_adapter.py" name="hesai_pointxyzirc_adapter" output="screen">
    <param name="input_topic" value="$(var input/raw_pointcloud)"/>
    <param name="output_topic" value="$(var input/pointcloud)"/>
    <param name="ring_count" value="32"/>
  </node>

  <!-- 2. BEVFusion Node -->
  <include file="$(find-pkg-share autoware_bevfusion)/launch/bevfusion.launch.xml">
    <arg name="model_name" value="$(var model_name)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="model_path" value="$(var model_path)"/>
    <arg name="input/pointcloud" value="$(var input/pointcloud)"/>
    <arg name="output/objects" value="$(var output/objects)"/>
    <arg name="build_only" value="$(var build_only)"/>
    <arg name="log_level" value="$(var log_level)"/>
    <arg name="use_pointcloud_container" value="false"/>
    <arg name="bevfusion_image0" value="$(var camera_image)"/>
    <arg name="bevfusion_camera_info0" value="$(var camera_info)"/>
  </include>
</launch>
