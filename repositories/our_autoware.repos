# E-Trike custom Autoware packages
# These packages provide the vehicle interface for the E-Trike tricycle.
# See docs/av-project-deployment-plan.md for deployment details.

repositories:
  our_packages/etrike_protocol:
    type: git
    url: https://github.com/your-org/etrike_protocol.git
    version: main
  our_packages/autoware_vehicle_bridge:
    type: git
    url: https://github.com/your-org/autoware_vehicle_bridge.git
    version: main
  our_packages/etrike_vehicle_launch:
    type: git
    url: https://github.com/your-org/etrike_vehicle_launch.git
    version: main
  our_packages/etrike_vehicle_description:
    type: git
    url: https://github.com/your-org/etrike_vehicle_description.git
    version: main
