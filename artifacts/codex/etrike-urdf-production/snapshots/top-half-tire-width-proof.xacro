<?xml version="1.0"?>
<robot name="etrike_top_width_proof">
  <!-- Flat plan-view validation aid only; not part of the production URDF. -->
  <material name="body_blue"><color rgba="0.035 0.235 0.510 1"/></material>
  <material name="tire_black"><color rgba="0.025 0.025 0.030 1"/></material>

  <link name="plan_view">
    <!-- Tires are behind the blue body plane. The visible outer strips are
         0.051 m each: exactly half of the 0.102 m tire width. -->
    <visual name="rear_left_tire_plan">
      <origin xyz="0 0 1.275" rpy="0 0 0"/>
      <geometry><box size="0.406 0.015 0.102"/></geometry>
      <material name="tire_black"/>
    </visual>
    <visual name="rear_right_tire_plan">
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><box size="0.406 0.015 0.102"/></geometry>
      <material name="tire_black"/>
    </visual>
    <visual name="front_tire_plan">
      <origin xyz="2.000 0 0.700" rpy="0 0 0"/>
      <geometry><box size="0.406 0.015 0.102"/></geometry>
      <material name="tire_black"/>
    </visual>

    <visual name="main_body_plan">
      <origin xyz="0.4575 -0.020 0.700" rpy="0 0 0"/>
      <geometry><box size="1.485 0.020 1.150"/></geometry>
      <material name="body_blue"/>
    </visual>
    <visual name="front_body_plan">
      <origin xyz="1.500 -0.020 0.700" rpy="0 0 0"/>
      <geometry><box size="0.600 0.020 0.960"/></geometry>
      <material name="body_blue"/>
    </visual>
  </link>
</robot>
