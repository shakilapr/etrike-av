<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>direct_bridge</name>
  <version>0.1.0</version>
  <description>
    Standalone ROS 2 bridge for bench ECU bring-up and commissioning of the
    E-Trike low-level CAN bus. Drives the MTR motor controller, the SES
    steering unit, and the SEB brake unit directly, bypassing the RT and SYS
    ECU layers. Bench bring-up tool only; not for autonomous operation.
  </description>
  <maintainer email="dev@etrike.local">E-Trike Dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>autoware_control_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>tier4_vehicle_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
