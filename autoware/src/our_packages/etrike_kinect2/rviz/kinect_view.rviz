Panels:
  - Class: rviz_common/Displays
    Name: Displays

Visualization Manager:
  Class: ""

  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Front Color
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /kinect_front/color/image_raw
      Value: true

    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Front Depth
      Max Value: 10
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /kinect_front/depth/image_raw
      Value: true

    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Rear Color
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /kinect_rear/color/image_raw
      Value: false

    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Rear Depth
      Max Value: 10
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /kinect_rear/depth/image_raw
      Value: false

  Enabled: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Name: root

  Tools:
    - Class: rviz_default_plugins/Interact

    - Class: rviz_default_plugins/MoveCamera

    - Class: rviz_default_plugins/Select

    - Class: rviz_default_plugins/FocusCamera

  Value: true

Window Geometry:
  Height: 900
  Width: 1400
  X: 100
  Y: 100
