<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="etrike">
  <!--
    Bajaj RE three-wheeler geometry.
    Frame convention: +X forward, +Y left, +Z up. base_footprint is the
    ground projection of the rear axle midpoint.

    Keep preview-time expressions compatible with rde-urdf's JavaScript
    xacro parser. Control parameters are mirrored in vehicle_info.param.yaml.
  -->
  <xacro:property name="wheel_base" value="2.000"/>
  <xacro:property name="rear_track" value="1.150"/>
  <xacro:property name="half_rear_track" value="0.575"/>
  <xacro:property name="wheel_radius" value="0.203"/>
  <xacro:property name="wheel_width" value="0.102"/>
  <xacro:property name="max_steer_angle" value="0.747"/>

  <xacro:property name="overall_length" value="2.635"/>
  <xacro:property name="overall_width" value="1.300"/>
  <xacro:property name="overall_height" value="1.700"/>
  <xacro:property name="ground_clearance" value="0.170"/>

  <!-- Visual-envelope split: front tire edge to rear body panel. Measure the
       physical vehicle before footprint-critical deployment. -->
  <xacro:property name="front_overhang" value="0.203"/>
  <xacro:property name="rear_overhang" value="0.432"/>

  <material name="body_blue"><color rgba="0.035 0.235 0.510 1.0"/></material>
  <material name="tire_black"><color rgba="0.025 0.025 0.030 1.0"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <!--
      One closed, undecorated Bajaj-style visual body. A small convex collision
      decomposition follows the same envelope. The body ends behind the front
      wheel, leaving all three tires completely external and uncovered.
    -->
    <inertial>
      <origin xyz="0.550 0 0.800" rpy="0 0 0"/>
      <mass value="337.0"/>
      <inertia ixx="80.88" ixy="0" ixz="0" iyy="152.75" iyz="0" izz="152.75"/>
    </inertial>

    <visual name="solid_body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://etrike_vehicle_description/meshes/etrike_body.stl" scale="1 1 1"/>
      </geometry>
      <material name="body_blue"/>
    </visual>

    <collision name="chassis_collision">
      <origin xyz="0.690 0 0.225" rpy="0 0 0"/>
      <geometry><box size="1.950 0.240 0.110"/></geometry>
    </collision>
    <collision name="lower_body_collision">
      <origin xyz="0.583 0 0.550" rpy="0 0 0"/>
      <geometry><box size="1.735 0.900 0.550"/></geometry>
    </collision>
    <collision name="cabin_collision">
      <origin xyz="0.550 0 1.245" rpy="0 0 0"/>
      <geometry><box size="1.650 1.100 0.830"/></geometry>
    </collision>
    <collision name="sloped_front_collision">
      <origin xyz="1.575 0 0.895" rpy="0 0.650 0"/>
      <geometry><box size="0.600 0.900 0.240"/></geometry>
    </collision>
    <collision name="front_apron_collision">
      <origin xyz="1.625 0 0.400" rpy="0 0 0"/>
      <geometry><box size="0.290 0.800 0.180"/></geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.0894" ixy="0" ixz="0" iyy="0.1648" iyz="0" izz="0.0894"/>
    </inertial>
    <visual name="rear_left_tire">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="0 ${half_rear_track} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="120.0" velocity="45.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="rear_right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.0894" ixy="0" ixz="0" iyy="0.1648" iyz="0" izz="0.0894"/>
    </inertial>
    <visual name="rear_right_tire">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="0 -${half_rear_track} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="120.0" velocity="45.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Steering knuckle is at the documented front-wheel center. -->
  <link name="front_steering_link">
    <inertial>
      <origin xyz="-0.030 0 0.180" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0078" ixy="0" ixz="0" iyy="0.0078" iyz="0" izz="0.0006"/>
    </inertial>
    <collision name="steering_carrier_collision">
      <origin xyz="-0.030 0 0.180" rpy="0 0 0"/>
      <geometry><box size="0.060 0.060 0.360"/></geometry>
    </collision>
  </link>
  <joint name="front_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_steering_link"/>
    <origin xyz="${wheel_base} 0 ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${max_steer_angle}" upper="${max_steer_angle}" effort="200.0" velocity="1.5"/>
    <dynamics damping="2.0" friction="1.0"/>
  </joint>

  <link name="front_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.0894" ixy="0" ixz="0" iyy="0.1648" iyz="0" izz="0.0894"/>
    </inertial>
    <visual name="front_tire">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
  </link>
  <joint name="front_wheel_joint" type="continuous">
    <parent link="front_steering_link"/>
    <child link="front_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="120.0" velocity="45.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
</robot>
