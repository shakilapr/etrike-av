<view name="view_drive_plot" extends="lv_obj" width="800" height="480" style="inspector_bg">
    <!-- Top Telemetry & Navigation Header (48px) -->
    <lv_obj name="plot_header" width="784" height="48" align="top_mid" y="6" style="tool_card"
            layout="flex" flex_flow="row" flex_align_main="space_between" flex_align_cross="center">
        <lv_label text="DRIVE (MTR)" text_font="montserrat_20" text_color="#ffffff" />
        <lv_label name="lbl_cmd" text="CMD: 15.0 km/h" text_font="montserrat_16" text_color="#06b6d4" />
        <lv_label name="lbl_act" text="ACT: 14.8 km/h" text_font="montserrat_16" text_color="#10b981" />
        <lv_label name="lbl_delta" text="Δ: 0.2 km/h [OK]" text_font="montserrat_16" text_color="#10b981" />
        <lv_label name="lbl_rpm" text="MTR: 1620 RPM" text_font="montserrat_16" text_color="#38bdf8" />
        <lv_button name="btn_back_num" style="nav_tab_default" width="110" height="36">
            <lv_label text="&lt; NUMERICS" align="center" text_font="montserrat_14" />
        </lv_button>
    </lv_obj>

    <!-- 15-Second Oscilloscope Chart (Speed 0-30 km/h) -->
    <lv_chart name="chart_drive" width="784" height="352" align="top_mid" y="58" style="scope_chart"
              type="line" point_count="150"
              range_primary_y_min="0" range_primary_y_max="30">
        <series name="ser_cmd" color="#06b6d4" axis="primary_y" />
        <series name="ser_act" color="#10b981" axis="primary_y" />
    </lv_chart>

    <!-- Bottom Controls & Time Scale -->
    <lv_obj name="plot_bottom" width="784" height="52" align="bottom_mid" y="-6"
            bg_opa="0" border_width="0" pad_all="0" layout="flex" flex_flow="row" flex_align_main="space_between" flex_align_cross="center">
        <lv_label text="Time: -15s ... -10s ... -5s ... NOW  (10Hz)" text_color="#888888" text_font="montserrat_14" />
        <lv_obj width="380" height="52" bg_opa="0" border_width="0" pad_all="0"
                layout="flex" flex_flow="row" flex_align_main="end" flex_align_cross="center" pad_column="12">
            <lv_button name="btn_pause" style="btn_scope_ctrl" width="180" height="50">
                <lv_label text="|| PAUSE / FREEZE" align="center" />
            </lv_button>
            <lv_button name="btn_next_plot" style="btn_scope_nav" width="180" height="50">
                <lv_label text="STEER PLOT &gt;" align="center" />
            </lv_button>
        </lv_obj>
    </lv_obj>
</view>
