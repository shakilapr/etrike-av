<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="etrike">
  <!--
    Bajaj RE three-wheeler geometry.
    Frame convention: +X forward, +Y left, +Z up. base_footprint is the
    ground projection of the rear axle midpoint.

    Keep preview-time expressions compatible with rde-urdf's JavaScript
    xacro parser. Control parameters are mirrored in vehicle_info.param.yaml.
  -->
  <xacro:property name="wheel_base" value="2.000"/>
  <xacro:property name="rear_track" value="1.150"/>
  <xacro:property name="half_rear_track" value="0.575"/>
  <xacro:property name="wheel_radius" value="0.203"/>
  <xacro:property name="wheel_width" value="0.102"/>
  <xacro:property name="max_steer_angle" value="0.747"/>

  <xacro:property name="overall_length" value="2.635"/>
  <xacro:property name="overall_width" value="1.300"/>
  <xacro:property name="overall_height" value="1.700"/>
  <xacro:property name="ground_clearance" value="0.170"/>

  <!-- Estimated split; replace after measuring the physical vehicle. -->
  <xacro:property name="front_overhang" value="0.350"/>
  <xacro:property name="rear_overhang" value="0.285"/>

  <xacro:property name="rear_body_length" value="1.550"/>
  <xacro:property name="rear_body_center_x" value="${-rear_overhang + rear_body_length / 2.0}"/>

  <material name="body_blue"><color rgba="0.035 0.235 0.510 1.0"/></material>
  <material name="body_blue_light"><color rgba="0.070 0.370 0.720 1.0"/></material>
  <material name="tire_black"><color rgba="0.025 0.025 0.030 1.0"/></material>
  <material name="hub_metal"><color rgba="0.55 0.58 0.62 1.0"/></material>
  <material name="trim_dark"><color rgba="0.055 0.070 0.080 1.0"/></material>
  <material name="canopy_black"><color rgba="0.035 0.040 0.045 1.0"/></material>
  <material name="window_glass"><color rgba="0.10 0.27 0.34 0.55"/></material>
  <material name="headlamp"><color rgba="1.0 0.82 0.25 1.0"/></material>
  <material name="tail_lamp"><color rgba="0.80 0.025 0.015 1.0"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <!-- Narrow central spine keeps all three motorcycle-style wheels exposed. -->
    <visual name="chassis">
      <origin xyz="0.708 0 0.230" rpy="0 0 0"/>
      <geometry><box size="1.985 0.280 0.120"/></geometry>
      <material name="trim_dark"/>
    </visual>

    <!-- Passenger body and front cowling. -->
    <visual name="rear_body">
      <origin xyz="${rear_body_center_x} 0 0.620" rpy="0 0 0"/>
      <geometry><box size="${rear_body_length} 0.880 0.360"/></geometry>
      <material name="body_blue"/>
    </visual>
    <visual name="sloped_front_scudo">
      <origin xyz="1.820 0 0.780" rpy="0 0.380 0"/>
      <geometry><box size="0.780 0.850 0.140"/></geometry>
      <material name="body_blue_light"/>
    </visual>
    <visual name="front_apron">
      <origin xyz="2.300 0 0.610" rpy="0 0 0"/>
      <geometry><box size="0.100 0.850 0.500"/></geometry>
      <material name="body_blue_light"/>
    </visual>
    <visual name="cabin_belt">
      <origin xyz="0.620 0 0.910" rpy="0 0 0"/>
      <geometry><box size="1.720 1.200 0.140"/></geometry>
      <material name="body_blue"/>
    </visual>
    <visual name="left_side_step">
      <origin xyz="0.930 0.625 0.260" rpy="0 0 0"/>
      <geometry><box size="1.300 0.050 0.100"/></geometry>
      <material name="trim_dark"/>
    </visual>
    <visual name="right_side_step">
      <origin xyz="0.930 -0.625 0.260" rpy="0 0 0"/>
      <geometry><box size="1.300 0.050 0.100"/></geometry>
      <material name="trim_dark"/>
    </visual>

    <!-- Cabin roof, rear wall, and structural pillars. -->
    <visual name="roof">
      <origin xyz="0.620 0 1.660" rpy="0 0 0"/>
      <geometry><box size="1.720 1.220 0.080"/></geometry>
      <material name="canopy_black"/>
    </visual>
    <visual name="rear_cabin_wall">
      <origin xyz="-0.180 0 1.285" rpy="0 0 0"/>
      <geometry><box size="0.100 1.160 0.670"/></geometry>
      <material name="body_blue"/>
    </visual>
    <visual name="front_left_pillar">
      <origin xyz="1.410 0.555 1.285" rpy="0 0 0"/>
      <geometry><box size="0.085 0.085 0.670"/></geometry>
      <material name="body_blue"/>
    </visual>
    <visual name="front_right_pillar">
      <origin xyz="1.410 -0.555 1.285" rpy="0 0 0"/>
      <geometry><box size="0.085 0.085 0.670"/></geometry>
      <material name="body_blue"/>
    </visual>
    <visual name="rear_left_pillar">
      <origin xyz="-0.140 0.555 1.285" rpy="0 0 0"/>
      <geometry><box size="0.085 0.085 0.670"/></geometry>
      <material name="body_blue"/>
    </visual>
    <visual name="rear_right_pillar">
      <origin xyz="-0.140 -0.555 1.285" rpy="0 0 0"/>
      <geometry><box size="0.085 0.085 0.670"/></geometry>
      <material name="body_blue"/>
    </visual>

    <!-- Glazing and interior provide readable orientation in the preview. -->
    <visual name="windshield">
      <origin xyz="1.425 0 1.295" rpy="0 -0.08 0"/>
      <geometry><box size="0.024 0.960 0.570"/></geometry>
      <material name="window_glass"/>
    </visual>
    <!-- Side apertures intentionally remain open, as on a passenger tuk-tuk. -->
    <visual name="driver_seat">
      <origin xyz="0.920 0 0.880" rpy="0 0 0"/>
      <geometry><box size="0.390 0.700 0.150"/></geometry>
      <material name="trim_dark"/>
    </visual>
    <visual name="seat_back">
      <origin xyz="0.710 0 1.090" rpy="0 0 0"/>
      <geometry><box size="0.100 0.700 0.500"/></geometry>
      <material name="trim_dark"/>
    </visual>
    <visual name="passenger_bench">
      <origin xyz="0.180 0 0.815" rpy="0 0 0"/>
      <geometry><box size="0.520 0.960 0.130"/></geometry>
      <material name="trim_dark"/>
    </visual>
    <visual name="passenger_backrest">
      <origin xyz="-0.030 0 1.055" rpy="0 0 0"/>
      <geometry><box size="0.100 0.960 0.500"/></geometry>
      <material name="trim_dark"/>
    </visual>

    <!-- Bumpers and lamps make the vehicle's front/rear unambiguous. -->
    <visual name="front_bumper">
      <origin xyz="2.315 0 0.390" rpy="0 0 0"/>
      <geometry><box size="0.070 0.880 0.110"/></geometry>
      <material name="trim_dark"/>
    </visual>
    <visual name="front_left_headlamp">
      <origin xyz="2.332 0.255 0.620" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.090" length="0.035"/></geometry>
      <material name="headlamp"/>
    </visual>
    <visual name="front_right_headlamp">
      <origin xyz="2.332 -0.255 0.620" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.090" length="0.035"/></geometry>
      <material name="headlamp"/>
    </visual>
    <visual name="rear_left_tail_lamp">
      <origin xyz="-0.267 0.350 0.650" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.070" length="0.035"/></geometry>
      <material name="tail_lamp"/>
    </visual>
    <visual name="rear_right_tail_lamp">
      <origin xyz="-0.267 -0.350 0.650" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.070" length="0.035"/></geometry>
      <material name="tail_lamp"/>
    </visual>

    <!-- Conservative collision envelope; refine after a body scan. -->
    <collision name="chassis_collision">
      <origin xyz="0.708 0 0.230" rpy="0 0 0"/>
      <geometry><box size="1.985 0.280 0.120"/></geometry>
    </collision>
    <collision name="rear_body_collision">
      <origin xyz="${rear_body_center_x} 0 0.620" rpy="0 0 0"/>
      <geometry><box size="${rear_body_length} 0.880 0.360"/></geometry>
    </collision>
    <collision name="front_scudo_collision">
      <origin xyz="1.820 0 0.780" rpy="0 0.380 0"/>
      <geometry><box size="0.780 0.840 0.140"/></geometry>
    </collision>
    <collision name="front_apron_collision">
      <origin xyz="2.300 0 0.610" rpy="0 0 0"/>
      <geometry><box size="0.100 0.840 0.500"/></geometry>
    </collision>
    <collision name="cabin_collision">
      <origin xyz="0.620 0 1.285" rpy="0 0 0"/>
      <geometry><box size="1.720 1.220 0.750"/></geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <visual name="rear_left_tire">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="tire_black"/>
    </visual>
    <visual name="rear_left_hub">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.090" length="0.108"/></geometry>
      <material name="hub_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="0 ${half_rear_track} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="120.0" velocity="45.0"/>
  </joint>

  <link name="rear_right_wheel_link">
    <visual name="rear_right_tire">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="tire_black"/>
    </visual>
    <visual name="rear_right_hub">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.090" length="0.108"/></geometry>
      <material name="hub_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="0 -${half_rear_track} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="120.0" velocity="45.0"/>
  </joint>

  <!-- Steering knuckle is at the documented front-wheel center. -->
  <link name="front_steering_link">
    <visual name="front_fork">
      <origin xyz="-0.030 0 0.235" rpy="0 0 0"/>
      <geometry><box size="0.080 0.080 0.470"/></geometry>
      <material name="body_blue"/>
    </visual>
  </link>
  <joint name="front_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_steering_link"/>
    <origin xyz="${wheel_base} 0 ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${max_steer_angle}" upper="${max_steer_angle}" effort="200.0" velocity="1.5"/>
  </joint>

  <link name="front_wheel_link">
    <visual name="front_tire">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="tire_black"/>
    </visual>
    <visual name="front_hub">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.090" length="0.108"/></geometry>
      <material name="hub_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
  </link>
  <joint name="front_wheel_joint" type="continuous">
    <parent link="front_steering_link"/>
    <child link="front_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="120.0" velocity="45.0"/>
  </joint>
</robot>
