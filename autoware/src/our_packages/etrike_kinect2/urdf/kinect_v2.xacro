<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    Microsoft Kinect v2 (Kinect One) sensor frames.

    Physical dimensions (approximate):
      Body: 249mm x 66mm x 67mm (W x H x D)
      Depth range: 0.5 – 4.5 m
      RGB: 1920x1080, Depth/IR: 512x424

    Frame convention:
      - Kinect sensor frame: X-right, Y-down, Z-forward (into scene)
      - Optical frame: X-right, Y-down, Z-forward
        (same as sensor frame for Kinect v2)

    Two instances: front (facing forward) and rear (facing backward).
    Extrinsic poses are placeholders — calibrate after physical mounting.
  -->

  <xacro:macro name="kinect_v2_macro" params="name parent x y z roll pitch yaw">
    <!-- Sensor body link -->
    <link name="${name}_link">
      <visual name="body">
        <origin xyz="0 0 0.0335" rpy="0 0 0"/>
        <geometry><box size="0.249 0.066 0.067"/></geometry>
        <material name="kinect_dark"><color rgba="0.1 0.1 0.12 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.0335" rpy="0 0 0"/>
        <geometry><box size="0.249 0.066 0.067"/></geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>

    <!-- RGB optical frame (same as sensor frame for Kinect v2) -->
    <link name="${name}_rgb_optical_frame"/>
    <joint name="${name}_rgb_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_rgb_optical_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Depth/IR optical frame -->
    <link name="${name}_depth_optical_frame"/>
    <joint name="${name}_depth_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- IR optical frame -->
    <link name="${name}_ir_optical_frame"/>
    <joint name="${name}_ir_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_ir_optical_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
