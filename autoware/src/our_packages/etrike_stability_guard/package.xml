<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>etrike_stability_guard</name>
  <version>0.1.0</version>
  <description>Roll/tip-over stability guard for the E-Trike three-wheeler.</description>
  <maintainer email="dev@etrike.local">E-Trike Dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>python3</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>
  <exec_depend>tier4_vehicle_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
