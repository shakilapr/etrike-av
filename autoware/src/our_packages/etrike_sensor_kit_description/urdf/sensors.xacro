<?xml version="1.0"?>
<robot name="vehicle" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="config_dir" default="$(find etrike_sensor_kit_description)/config"/>
  <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensors_calibration.yaml')}"/>

  <!-- sensor kit -->
  <xacro:include filename="sensor_kit.xacro"/>

  <!-- Kinect v2 cameras -->
  <xacro:include filename="$(find etrike_kinect2)/urdf/kinect_v2.xacro"/>

  <!-- FRONT Kinect - windshield area, facing forward -->
  <xacro:kinect_v2_macro
    name="kinect_front"
    parent="base_link"
    x="${calibration['base_link']['kinect_front']['x']}"
    y="${calibration['base_link']['kinect_front']['y']}"
    z="${calibration['base_link']['kinect_front']['z']}"
    roll="${calibration['base_link']['kinect_front']['roll']}"
    pitch="${calibration['base_link']['kinect_front']['pitch']}"
    yaw="${calibration['base_link']['kinect_front']['yaw']}"
  />

  <!-- REAR Kinect - behind cabin, facing backward -->
  <xacro:kinect_v2_macro
    name="kinect_rear"
    parent="base_link"
    x="${calibration['base_link']['kinect_rear']['x']}"
    y="${calibration['base_link']['kinect_rear']['y']}"
    z="${calibration['base_link']['kinect_rear']['z']}"
    roll="${calibration['base_link']['kinect_rear']['roll']}"
    pitch="${calibration['base_link']['kinect_rear']['pitch']}"
    yaw="${calibration['base_link']['kinect_rear']['yaw']}"
  />
  <xacro:sensor_kit_macro
    parent="base_link"
    x="${calibration['base_link']['sensor_kit_base_link']['x']}"
    y="${calibration['base_link']['sensor_kit_base_link']['y']}"
    z="${calibration['base_link']['sensor_kit_base_link']['z']}"
    roll="${calibration['base_link']['sensor_kit_base_link']['roll']}"
    pitch="${calibration['base_link']['sensor_kit_base_link']['pitch']}"
    yaw="${calibration['base_link']['sensor_kit_base_link']['yaw']}"
  />
</robot>
