<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>etrike_sensor_kit_launch</name>
  <version>0.1.0</version>
  <description>Sensor-kit sensing launch for the E-Trike (Hesai XT32M2X via Nebula).</description>
  <maintainer email="dev@etrike.local">E-Trike Dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <exec_depend>autoware_vehicle_velocity_converter</exec_depend>
  <exec_depend>etrike_common_launch</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>autoware_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
