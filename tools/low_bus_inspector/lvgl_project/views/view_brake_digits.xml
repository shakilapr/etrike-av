<view name="view_brake_digits" extends="lv_obj" width="800" height="480" style="inspector_bg">
    <!-- Top Persistent Navigation Header -->
    <lv_obj name="top_nav" width="800" height="52" align="top_mid" style="nav_bar_container"
            layout="flex" flex_flow="row" flex_align_main="space_between" flex_align_cross="center">
        <lv_button name="btn_nav_gen" style="nav_tab_default" width="185" height="44">
            <lv_label text="0. BUS &amp; SAFETY" align="center" />
        </lv_button>
        <lv_button name="btn_nav_steer" style="nav_tab_default" width="185" height="44">
            <lv_label text="1. STEER (SES)" align="center" />
        </lv_button>
        <lv_button name="btn_nav_brake" style="nav_tab_active" width="185" height="44">
            <lv_label text="2. BRAKE (SEB)" align="center" />
        </lv_button>
        <lv_button name="btn_nav_drive" style="nav_tab_default" width="185" height="44">
            <lv_label text="3. DRIVE (MTR)" align="center" />
        </lv_button>
    </lv_obj>

    <!-- Main Content Area -->
    <lv_obj name="content_area" width="784" height="416" align="bottom_mid" y="-6"
            bg_opa="0" border_width="0" pad_all="0" layout="flex" flex_flow="column" pad_row="10">

        <!-- 3-Column Actuation Metrics Deck (254px cards) -->
        <lv_obj name="row_metrics" width="784" height="348" bg_opa="0" border_width="0" pad_all="0"
                layout="flex" flex_flow="row" flex_align_main="space_between">

            <!-- Card 1: Command (VCU 0x7B9) -->
            <lv_obj name="card_cmd" width="254" height="348" style="tool_card"
                    layout="flex" flex_flow="column" flex_align_main="space_between" flex_align_cross="center">
                <lv_label text="COMMAND (VCU 0x7B9)" style="field_label" />
                <lv_obj width="230" height="100" bg_opa="0" border_width="0" layout="flex" flex_flow="column" flex_align_main="center" flex_align_cross="center">
                    <lv_label name="val_brake_cmd" text="450" style="hero_val_cyan" text_font="montserrat_48" />
                    <lv_label text="kPa" style="unit_label" />
                </lv_obj>
                <lv_obj width="230" height="50" style="tool_card" layout="flex" flex_flow="column" flex_align_main="center" flex_align_cross="center">
                    <lv_label text="TARGET STROKE: 18.0 mm" text_font="montserrat_16" text_color="#ffffff" />
                </lv_obj>
                <lv_label text="[ OK ] AUTOBRAKE ARMED" text_color="#10b981" text_font="montserrat_16" />
                <lv_label text="[ OK ] CLOSED-LOOP PRESSURE" text_color="#64748b" text_font="montserrat_14" />
            </lv_obj>

            <!-- Card 2: Actual Feedback (SEB 0x721) -->
            <lv_obj name="card_act" width="254" height="348" style="tool_card"
                    layout="flex" flex_flow="column" flex_align_main="space_between" flex_align_cross="center">
                <lv_label text="ACTUATION (SEB 0x721)" style="field_label" />
                <lv_obj width="230" height="100" bg_opa="0" border_width="0" layout="flex" flex_flow="column" flex_align_main="center" flex_align_cross="center">
                    <lv_label name="val_brake_act" text="442" style="hero_val_emerald" text_font="montserrat_48" />
                    <lv_label text="kPa" text_color="#10b981" text_font="montserrat_20" />
                </lv_obj>
                <lv_obj width="230" height="50" style="tool_card" layout="flex" flex_flow="column" flex_align_main="center" flex_align_cross="center">
                    <lv_label text="ACTUAL STROKE: 17.8 mm" text_font="montserrat_16" text_color="#ffffff" />
                </lv_obj>
                <lv_label text="[ OK ] CLOSED-LOOP PRESSURE" text_color="#10b981" text_font="montserrat_16" />
                <lv_label text="[ OK ] SEB ARMED • READY" text_color="#64748b" text_font="montserrat_14" />
            </lv_obj>

            <!-- Card 3: Delta & Piston Stroke -->
            <lv_obj name="card_delta" width="254" height="348" style="tool_card"
                    layout="flex" flex_flow="column" flex_align_main="space_between" flex_align_cross="center">
                <!-- 2-Tier Delta Badge -->
                <lv_obj name="badge_delta" width="230" height="74" style="badge_delta_ok"
                        layout="flex" flex_flow="column" flex_align_main="center" flex_align_cross="center">
                    <lv_label name="val_brake_delta" text="Δ: -8 kPa" text_font="montserrat_20" text_color="#ffffff" />
                    <lv_label text="[ TRACKING OK ]" text_font="montserrat_14" text_color="#34d399" />
                </lv_obj>

                <!-- Piston Displacement Box -->
                <lv_obj name="box_stroke" width="230" height="130" style="tool_card" border_color="#38bdf8"
                        layout="flex" flex_flow="column" flex_align_main="space_between" flex_align_cross="center">
                    <lv_label text="PISTON DISPLACEMENT" text_font="montserrat_14" text_color="#38bdf8" />
                    <lv_label name="val_brake_stroke" text="17.8 mm" style="hero_val_white" text_font="montserrat_48" />
                    <lv_label text="[ STROKE Δ: 0.2 mm OK ]" text_font="montserrat_14" text_color="#10b981" />
                </lv_obj>

                <lv_label text="[ OK ] SEB ECU: HEALTHY" text_color="#10b981" text_font="montserrat_16" />
                <lv_label text="Motor: 4.2A  •  Temp: 38°C" text_color="#ffffff" text_font="montserrat_14" />
            </lv_obj>
        </lv_obj>

        <!-- Bottom Action Bar: Jump to 15s Scope Plot (Full-Width 58px) -->
        <lv_button name="btn_goto_plot" style="btn_action_full" width="784" height="58">
            <lv_label text="VIEW 15-SECOND BRAKE PRESSURE SCOPE (OR SWIPE DOWN) &gt;" align="center" />
        </lv_button>
    </lv_obj>
</view>
