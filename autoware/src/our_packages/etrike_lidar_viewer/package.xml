<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>etrike_lidar_viewer</name>
  <version>0.1.0</version>
  <description>Minimal Hesai XT32M2X driver + RViz2 point cloud viewer for the E-Trike.</description>
  <maintainer email="dev@etrike.local">E-Trike Dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>etrike_common_launch</exec_depend>
  <exec_depend>nebula_hesai</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
