<launch>
  <!-- IMU launch stub for the E-Trike.
       NOTE: The Hesai XT32M2X lidar does NOT contain an IMU (it measures
       only distance/azimuth/reflectivity). The IMU is a separate sensor to
       be sourced and installed later.
       When a physical IMU is connected, replace this with the actual IMU
       driver launch (e.g., tamagawa_imu, xsens, etc.) publishing to
       /sensing/imu/imu_data.
       Currently launches a placeholder that the distortion_corrector_node
       can subscribe to once a real IMU is available. -->
  <arg name="launch_driver" default="true"/>
  <group>
    <push-ros-namespace namespace="imu"/>
    <!-- TODO: Add actual IMU driver here. Example:
    <include file="$(find-pkg-share <imu_driver_pkg>)/launch/<imu>.launch.xml">
      <arg name="imu_frame" value="imu_link"/>
      <arg name="output_topic" value="imu_data"/>
    </include>
    -->
    <node pkg="topic_tools" exec="relay" name="imu_relay" if="$(var launch_driver)">
      <!-- Relay from a hardware IMU driver topic to the standard Autoware IMU topic -->
      <param name="input_topic" value="/imu_raw"/>
      <param name="output_topic" value="/sensing/imu/imu_data"/>
      <param name="lazy" value="true"/>
    </node>
    <node pkg="topic_tools" exec="relay" name="wheel_twist_to_localization_relay" if="$(var launch_driver)">
      <!-- Fallback twist relay so ekf_localizer receives wheel + bicycle-model yaw twist
           even when no hardware IMU is connected for gyro_odometer -->
      <param name="input_topic" value="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
      <param name="output_topic" value="/localization/twist_estimator/twist_with_covariance"/>
      <param name="lazy" value="true"/>
    </node>
  </group>
</launch>
