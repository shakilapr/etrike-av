# E-Trike Kinect build image.
#
# Extends the official Autoware (Humble) image with libfreenect2, which the
# etrike_kinect2 driver links against (pkg-config module: freenect2).
# Built once on the Jetson and reused for builds/shell.
#
# Build:
#   ./docker/make_image.sh
#
# The build arg lets the same Dockerfile track a specific Autoware base tag.
ARG AUTOWARE_BASE=ghcr.io/autowarefoundation/autoware:universe-cuda-humble
FROM ${AUTOWARE_BASE}

ENV DEBIAN_FRONTEND=noninteractive

# libfreenect2 build dependencies (CUDA pipeline for depth decode on the Orin
# GPU; TurboJPEG for color).
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        pkg-config \
        libusb-1.0-0-dev \
        libturbojpeg0-dev \
        libglfw3-dev \
        libssl-dev \
        ca-certificates \
        curl && \
    rm -rf /var/lib/apt/lists/*

# Build libfreenect2 from source (CUDA pipeline for depth decode) and install
# to /usr. The Autoware base image already ships CUDA 12.8 + nvcc, so the
# CudaPacketPipeline builds and runs on the Jetson AGX Orin.
#
# CUDA 12 removed helper_math.h from the toolkit (it moved to cuda-samples),
# but libfreenect2's cuda_*_packet_processor.cu still #includes it — fetch the
# canonical copy from NVIDIA's cuda-samples and put it on the nvcc include path.
RUN git clone --depth 1 https://github.com/OpenKinect/libfreenect2.git /tmp/libfreenect2 && \
    mkdir -p /tmp/cuda-helper && \
    curl -fsSL \
        https://raw.githubusercontent.com/NVIDIA/cuda-samples/master/Common/helper_math.h \
        -o /tmp/cuda-helper/helper_math.h && \
    cd /tmp/libfreenect2 && \
    mkdir -p build && cd build && \
    cmake .. \
        -DENABLE_OPENCL=OFF \
        -DENABLE_CUDA=ON \
        -DENABLE_OPENGL=OFF \
        -DENABLE_VAAPI=OFF \
        -DENABLE_TEGRAJPEG=OFF \
        -DBUILD_OPENNI2_DRIVER=OFF \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCUDA_NVCC_FLAGS="-I/tmp/cuda-helper -gencode arch=compute_87,code=sm_87 -gencode arch=compute_87,code=compute_87" && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig && \
    mkdir -p /etc/udev/rules.d && \
    cp platform/linux/udev/90-kinect2.rules /etc/udev/rules.d/ 2>/dev/null || true && \
    rm -rf /tmp/libfreenect2 /tmp/cuda-helper

# Sanity check available to the build.
RUN pkg-config --exists freenect2 && echo "libfreenect2 (freenect2.pc) present"
